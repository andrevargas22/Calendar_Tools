# Shared Google service account (same credentials used by both tools)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Calendar IDs — distinct per tool
GOOGLE_CALENDAR_ID_WORK=       # used by sync/ (Teams -> work Google Calendar)
GOOGLE_CALENDAR_ID_PERSONAL=   # used by agent/ (personal Google Calendar)
GOOGLE_CALENDAR_ID_PETS=       # used by agent/ (shared calendar for the dogs, Quico/Bibi)

# --- sync ---
TEAMS_ICS_URL=
LOG_MASK_TITLES=false
CANCEL_PREFIX=Canceled:

# --- agent ---
DEEPSEEK_API_KEY=
MLFLOW_TRACKING_URI=

# --- agent / telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=   # random string, e.g. `openssl rand -hex 32` — do not reuse elsewhere
